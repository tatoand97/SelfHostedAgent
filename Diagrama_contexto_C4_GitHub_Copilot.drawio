  <diagram id="contexto-c4" name="Contexto C4">
    <mxGraphModel dx="1640" dy="1110" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1640" pageHeight="1110" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Diagrama de contexto — GitHub Copilot" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=25;fontStyle=1;fontColor=#172B4D;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry x="50" y="25" width="900" height="36" as="geometry" />
        </mxCell>
        <mxCell id="developer" value="" style="group;" vertex="1" parent="1">
          <mxGeometry x="620" y="80" width="360" height="240" as="geometry" />
        </mxCell>
        <mxCell id="developer-head" value="" style="ellipse;html=1;fillColor=#8C8496;strokeColor=#8C8496;" vertex="1" parent="developer">
          <mxGeometry x="144.0" y="0" width="72" height="72" as="geometry" />
        </mxCell>
        <mxCell id="developer-body" value="&lt;b&gt;&lt;font style=&quot;font-size: 19px&quot;&gt;Desarrollador de software&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 13px&quot;&gt;[Person]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 15px; line-height: 1.3&quot;&gt;Utiliza Copilot para escribir, refactorizar y revisar código, resolver dudas técnicas y generar pruebas unitarias con apoyo de sugerencias contextuales.&lt;/font&gt;" style="rounded=1;arcSize=13;whiteSpace=wrap;html=1;fillColor=#8C8496;strokeColor=#8C8496;fontColor=#FFFFFF;fontFamily=Arial;align=center;verticalAlign=middle;spacing=16;shadow=0;" vertex="1" parent="developer">
          <mxGeometry x="0" y="60" width="360" height="180" as="geometry" />
        </mxCell>
        <mxCell id="governance" value="" style="group;" vertex="1" parent="1">
          <mxGeometry x="50" y="330" width="360" height="265" as="geometry" />
        </mxCell>
        <mxCell id="governance-head" value="" style="ellipse;html=1;fillColor=#8C8496;strokeColor=#8C8496;" vertex="1" parent="governance">
          <mxGeometry x="144.0" y="0" width="72" height="72" as="geometry" />
        </mxCell>
        <mxCell id="governance-body" value="&lt;b&gt;&lt;font style=&quot;font-size: 19px&quot;&gt;Analista de Gobierno IA&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 13px&quot;&gt;[Person]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 15px; line-height: 1.3&quot;&gt;Define políticas y estándares de uso responsable de IA; establece criterios de evaluación de modelos y supervisa métricas de adopción, rendimiento, riesgos y costos.&lt;/font&gt;" style="rounded=1;arcSize=13;whiteSpace=wrap;html=1;fillColor=#8C8496;strokeColor=#8C8496;fontColor=#FFFFFF;fontFamily=Arial;align=center;verticalAlign=middle;spacing=16;shadow=0;" vertex="1" parent="governance">
          <mxGeometry x="0" y="60" width="360" height="205" as="geometry" />
        </mxCell>
        <mxCell id="identity" value="" style="group;" vertex="1" parent="1">
          <mxGeometry x="1230" y="330" width="360" height="265" as="geometry" />
        </mxCell>
        <mxCell id="identity-head" value="" style="ellipse;html=1;fillColor=#8C8496;strokeColor=#8C8496;" vertex="1" parent="identity">
          <mxGeometry x="144.0" y="0" width="72" height="72" as="geometry" />
        </mxCell>
        <mxCell id="identity-body" value="&lt;b&gt;&lt;font style=&quot;font-size: 19px&quot;&gt;Analista Protección de Identidad&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 13px&quot;&gt;[Person]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 15px; line-height: 1.3&quot;&gt;Aplica las políticas de IA; gestiona usuarios, accesos y licencias, configura restricciones de uso y supervisa auditorías, telemetría y cumplimiento.&lt;/font&gt;" style="rounded=1;arcSize=13;whiteSpace=wrap;html=1;fillColor=#8C8496;strokeColor=#8C8496;fontColor=#FFFFFF;fontFamily=Arial;align=center;verticalAlign=middle;spacing=16;shadow=0;" vertex="1" parent="identity">
          <mxGeometry x="0" y="60" width="360" height="205" as="geometry" />
        </mxCell>
        <mxCell id="copilot" value="&lt;b&gt;&lt;font style=&quot;font-size: 19px&quot;&gt;GitHub Copilot&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 13px&quot;&gt;[Software System]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 15px; line-height: 1.3&quot;&gt;Asistente de IA que utiliza el contexto del código y los repositorios para generar sugerencias. Orquesta la interacción con modelos de lenguaje y aplica políticas de gobernanza y filtros de contenido.&lt;/font&gt;" style="rounded=1;arcSize=13;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#1168BD;fontColor=#FFFFFF;fontFamily=Arial;align=center;verticalAlign=middle;spacing=16;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="605" y="450" width="390" height="250" as="geometry" />
        </mxCell>
        <mxCell id="workstation" value="&lt;b&gt;&lt;font style=&quot;font-size: 19px&quot;&gt;Workstation&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 13px&quot;&gt;[External System]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 15px; line-height: 1.3&quot;&gt;Entorno local con IDEs, CLI y agentes donde se comparte el contexto de trabajo, se reciben sugerencias de Copilot y se ejecutan acciones de edición, refactorización y pruebas.&lt;/font&gt;" style="rounded=1;arcSize=13;whiteSpace=wrap;html=1;fillColor=#8C8496;strokeColor=#8C8496;fontColor=#FFFFFF;fontFamily=Arial;align=center;verticalAlign=middle;spacing=16;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="295" y="855" width="390" height="205" as="geometry" />
        </mxCell>
        <mxCell id="azure" value="&lt;b&gt;&lt;font style=&quot;font-size: 19px&quot;&gt;Azure Cloud&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 13px&quot;&gt;[External System]&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size: 15px; line-height: 1.3&quot;&gt;Centraliza identidad, autenticación y acceso con Microsoft Entra ID, y repositorios de código con Azure Repos; proporciona trazabilidad, auditoría e integración con servicios corporativos.&lt;/font&gt;" style="rounded=1;arcSize=13;whiteSpace=wrap;html=1;fillColor=#8C8496;strokeColor=#8C8496;fontColor=#FFFFFF;fontFamily=Arial;align=center;verticalAlign=middle;spacing=16;shadow=0;" vertex="1" parent="1">
